# Supabase - get these from your Supabase project Settings > API
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Only needed for server-side admin operations (user invites)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL, used to build invite/password links (no trailing slash).
# Must match a URL in the Supabase Auth "Redirect URLs" allow-list.
PUBLIC_SITE_URL=https://www.cafepalestinecolonia.de
