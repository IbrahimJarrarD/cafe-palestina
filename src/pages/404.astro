---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const lang = 'de';
---

<Layout title="Seite nicht gefunden (404)" lang={lang}>
  <Header lang={lang} />
  <main class="notfound">
    <div class="notfound-card">
      <div class="code">404</div>
      <h1>Seite nicht gefunden</h1>
      <p>Diese Seite existiert leider nicht (oder wurde verschoben).</p>
      <a href="/" class="home-link">← Zur Startseite</a>
    </div>
  </main>
  <Footer lang={lang} />
</Layout>

<style>
  .notfound {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 1rem;
  }

  .notfound-card {
    text-align: center;
    max-width: 480px;
  }

  .code {
    font-size: 5rem;
    font-weight: 800;
    line-height: 1;
    color: #1a3d2e;
    opacity: 0.85;
  }

  .notfound-card h1 {
    font-size: 1.75rem;
    font-weight: 700;
    color: #1a3d2e;
    margin: 1rem 0 0.5rem;
  }

  .notfound-card p {
    color: #6b7280;
    margin-bottom: 1.5rem;
  }

  .home-link {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: #1a3d2e;
    color: #ffffff;
    border-radius: 10px;
    text-decoration: none;
    font-weight: 600;
    transition: background 0.2s;
  }

  .home-link:hover {
    background: #2d5a47;
  }
</style>
