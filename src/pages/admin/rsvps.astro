---
import AdminLayout from '../../layouts/AdminLayout.astro';
import RsvpManager from '../../components/admin/RsvpManager.svelte';
---

<AdminLayout title="RSVPs" activeSection="rsvps">
  <div class="rsvps-page">
    <div class="page-header">
      <p class="subtitle">Event registrations: public sign-ups plus anyone you add from other sources</p>
    </div>

    <RsvpManager client:load />
  </div>
</AdminLayout>

<style>
  .rsvps-page {
    max-width: 980px;
  }

  .page-header {
    margin-bottom: 1.25rem;
  }

  .subtitle {
    color: var(--ink-light);
    font-size: 0.9rem;
  }
</style>
