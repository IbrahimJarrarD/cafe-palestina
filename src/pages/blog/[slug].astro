---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BlogPostView from '../../components/BlogPostView.astro';
import { getPostBySlug, getPostTitle, getPostDescription } from '../../lib/blog';

const lang = 'de';
const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/blog');
}

const post = await getPostBySlug(slug);

// Missing or unpublished slug: send the reader back to the listing.
if (!post) {
  return Astro.redirect('/blog');
}

const title = getPostTitle(post, lang);
const description = getPostDescription(post, lang);
---

<Layout title={`${title} | Cafe Palestine Colonia`} description={description} lang={lang}>
  <Header lang={lang} />
  <main>
    <BlogPostView post={post} lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
